# Postgres (используется сервисом postgres и cdp-core)
POSTGRES_DB=cdp_core
POSTGRES_USER=cdp_core
POSTGRES_PASSWORD=local dev secret

# cdp-core app config
CDP_CORE_POSTGRES_HOST=localhost
CDP_CORE_POSTGRES_PORT=5432
CDP_CORE_POSTGRES_DATABASE=cdp_core
CDP_CORE_POSTGRES_USER=cdp_core
CDP_CORE_POSTGRES_PASSWORD=local dev secret
CDP_CORE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CDP_CORE_KAFKA_EVENTS_V1_TOPIC=cdp.events.v1
CDP_CORE_KAFKA_EVENTS_DLQ_TOPIC=cdp.events.dlq
